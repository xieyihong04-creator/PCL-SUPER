<local:MyPageRight x:Class="PCL.PageInstanceModGraph"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:loc="https://ce.pclc.cc/core/localization"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}"
                   d:DesignHeight="450" d:DesignWidth="800">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="25,20,25,25">
            <local:MyCard Title="{loc:Loc Instance.ModGraph.Title}">
                <StackPanel Margin="15,40,25,16">
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.75"
                               Text="{loc:Loc Instance.ModGraph.Description}" />
                    <WrapPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnRefreshGraph" Click="BtnRefreshGraph_Click" MinWidth="100"
                                        Height="34" Padding="13,0"
                                        Text="{loc:Loc Instance.History.Refresh}" />
                        <TextBlock x:Name="LabSummary" Margin="14,0,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Opacity="0.75" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,15,0,0" Title="{loc:Loc Instance.ModGraph.CanvasTitle}">
                <local:MyScrollViewer Margin="15,0,10,10" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" MaxHeight="1400">
                    <Canvas x:Name="PanGraph" Background="Transparent" />
                </local:MyScrollViewer>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
